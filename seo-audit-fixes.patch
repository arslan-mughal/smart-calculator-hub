+function lastmodTag(iso: string | undefined): string {
+  return iso && /^\d{4}-\d{2}-\d{2}/.test(iso) ? `<lastmod>${iso.slice(0, 10)}</lastmod>` : "";
+}
+
+function sitemapXml(origin: string, blogPosts: SitemapPost[]): string {
