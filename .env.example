# Copy to .env and fill in. Generate the last two values with:
#   node scripts/hash-password.mjs "your-strong-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Public site origin (no trailing slash). Used for canonical URLs, Open Graph, sitemap and robots.txt.
VITE_SITE_URL=https://your-domain.com

# Neon Postgres (server-only, never put this in client code or commit a real value).
# REQUIRED on Vercel: without it, site settings and blog posts fall back to the
# local content/*.json files, which do not persist on serverless hosting.
# Optional locally: leave it empty to use the file store while developing.
# Use the *pooled* connection string from the Neon dashboard (it ends in -pooler...neon.tech).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require
